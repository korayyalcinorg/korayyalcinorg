{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/korayyalcinorg/korayyalcinorg/blob/main/data/publications.schema.json",
  "title": "Koray Yalcin Publications Index",
  "type": "object",
  "required": ["name", "author", "publisher", "canonical_hub", "updated", "items"],
  "properties": {
    "name": { "type": "string" },
    "author": { "type": "string" },
    "publisher": { "type": "string" },
    "canonical_hub": { "type": "string", "format": "uri" },
    "books_hub": { "type": "string", "format": "uri" },
    "updated": { "type": "string", "format": "date" },
    "language": {
      "type": "array",
      "items": { "type": "string" }
    },
    "topics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "type", "year", "language", "url", "topics"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "type": { "type": "string" },
          "year": { "type": "integer", "minimum": 1900 },
          "language": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "scope": { "type": "string" },
          "related_repository": { "type": "string", "format": "uri" },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
